{
  "name": "trust-chain-mcp",
  "description": "Trust Chain MCP server. Tools: create trust anchor, verify chain, add attestation. Built by MEOK AI Labs.",
  "version": "1.0.0",
  "tools": [
    {
      "name": "create_trust_anchor",
      "description": "Create a new trust anchor (root of trust) for an entity.",
      "parameters": {
        "type": "object",
        "properties": {
          "entity_id": {
            "type": "string"
          },
          "entity_name": {
            "type": "string"
          },
          "trust_level": {
            "type": "integer"
          },
          "metadata": {
            "type": "object"
          }
        },
        "required": [
          "entity_id",
          "entity_name"
        ]
      }
    },
    {
      "name": "verify_chain",
      "description": "Verify the integrity of a trust chain by validating all attestations.",
      "parameters": {
        "type": "object",
        "properties": {
          "anchor_id": {
            "type": "string"
          }
        },
        "required": [
          "anchor_id"
        ]
      }
    },
    {
      "name": "add_attestation",
      "description": "Add an attestation (claim) to an existing trust anchor.",
      "parameters": {
        "type": "object",
        "properties": {
          "anchor_id": {
            "type": "string"
          },
          "attester_id": {
            "type": "string"
          },
          "claim": {
            "type": "string"
          },
          "confidence": {
            "type": "number"
          },
          "evidence": {
            "type": "string"
          }
        },
        "required": [
          "anchor_id",
          "attester_id",
          "claim"
        ]
      }
    },
    {
      "name": "get_trust_score",
      "description": "Calculate a composite trust score for an anchor based on its attestations.",
      "parameters": {
        "type": "object",
        "properties": {
          "anchor_id": {
            "type": "string"
          }
        },
        "required": [
          "anchor_id"
        ]
      }
    },
    {
      "name": "revoke_trust",
      "description": "Revoke a trust anchor or attestation. This invalidates the chain.",
      "parameters": {
        "type": "object",
        "properties": {
          "target_id": {
            "type": "string"
          },
          "reason": {
            "type": "string"
          },
          "revoked_by": {
            "type": "string"
          }
        },
        "required": [
          "target_id",
          "reason",
          "revoked_by"
        ]
      }
    }
  ]
}